#!/bin/bash

#DEBHELPER#

for group in gpio spi; do
    getent group "$group" >/dev/null || groupadd --system "$group"
done
if id wlanpi >/dev/null 2>&1; then
    usermod --append --groups gpio,spi wlanpi
fi
if command -v udevadm >/dev/null && ! ischroot; then
    udevadm control --reload-rules || true
    udevadm trigger --subsystem-match=gpio --subsystem-match=spidev || true
fi

# Migrate the image-created override now that the package owns the setting.
IRTT_OVERRIDE=/etc/systemd/system/irtt.service.d/override.conf
if [ -f "$IRTT_OVERRIDE" ] && [ "$(cat "$IRTT_OVERRIDE")" = $'[Service]\nUser=wlanpi' ]; then
    rm -f "$IRTT_OVERRIDE"
    rmdir "${IRTT_OVERRIDE%/*}" 2>/dev/null || true
fi

systemctl daemon-reload 2>/dev/null || true
if systemctl is-active --quiet irtt.service; then
    deb-systemd-invoke try-restart irtt.service || true
fi

# Disable last login message after user SSHs in
if grep -q -E "^?PrintLastLog" /etc/ssh/sshd_config; then
    sudo sed -i "s/^#\?PrintLastLog.*/PrintLastLog no/" /etc/ssh/sshd_config
else
    echo "PrintLastLog no" >> /etc/ssh/sshd_config
fi

if ! ischroot; then
    echo "Restarting avahi-daemon ..."
    if ! deb-systemd-invoke restart avahi-daemon.service; then
        echo "avahi-daemon.service restart failed, continuing installation..." >&2
        systemctl status avahi-daemon.service >&2 || true
    fi
fi

# Install udev rule to disable iwlwifi ucode 92 at boot
echo "Installing udev rule to disable iwlwifi ucode 92 at boot..."

UDEV_RULE_FILE="/etc/udev/rules.d/50-iwlwifi-disable-v92.rules"
UDEV_RULE_CONTENT='# Disable iwlwifi v92 firmware at boot - Intel BE200
ACTION=="add", SUBSYSTEM=="pci", ATTR{vendor}=="0x8086", ATTR{device}=="0x272b", RUN+="/bin/sh -c '\''test -f /lib/firmware/iwlwifi-gl-c0-fm-c0-92.ucode && mv /lib/firmware/iwlwifi-gl-c0-fm-c0-92.ucode /lib/firmware/iwlwifi-gl-c0-fm-c0-92.ucode.disabled'\''"'

if echo "$UDEV_RULE_CONTENT" > "$UDEV_RULE_FILE"; then
    echo "Udev rule installed. Will take effect on next boot."
else
    echo "Warning: Failed to create udev rule file" >&2
fi

# Fails during apt install wlanpi-common due to apt lock conflict
#echo "Running apt update"
#apt update 1> /dev/null 2>& 1
