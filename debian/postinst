#!/bin/bash

#DEBHELPER#

# Undo the Intel BE200 v92 firmware workaround from earlier versions (#129).
# iwlwifi on the 7.x kernels only loads c102-c106 for the BE200 and never asks
# for v92, so the udev rule that renamed it only made dpkg --verify fail.
# Runs before the udevadm reload below so udevd drops the rule now.
# BEGIN iwlwifi v92 cleanup
V92=/lib/firmware/iwlwifi-gl-c0-fm-c0-92.ucode
rm -f /etc/udev/rules.d/50-iwlwifi-disable-v92.rules
if [ ! -e "$V92" ] && [ -f "$V92.disabled" ]; then
    mv "$V92.disabled" "$V92" || echo "Warning: could not restore $V92" >&2
fi
if [ -e "$V92" ]; then
    rm -f "$V92.disabled" "$V92.original"
fi
# END iwlwifi v92 cleanup

for group in gpio spi; do
    getent group "$group" >/dev/null || groupadd --system "$group"
done
if id wlanpi >/dev/null 2>&1; then
    usermod --append --groups gpio,spi wlanpi
fi
if command -v udevadm >/dev/null && ! ischroot; then
    udevadm control --reload-rules || true
    udevadm trigger --subsystem-match=gpio --subsystem-match=gpiomem --subsystem-match=spidev || true
fi

# Migrate the image-created override now that the package owns the setting.
IRTT_OVERRIDE=/etc/systemd/system/irtt.service.d/override.conf
if [ -f "$IRTT_OVERRIDE" ] && [ "$(cat "$IRTT_OVERRIDE")" = $'[Service]\nUser=wlanpi' ]; then
    rm -f "$IRTT_OVERRIDE"
    rmdir "${IRTT_OVERRIDE%/*}" 2>/dev/null || true
fi

systemctl daemon-reload 2>/dev/null || true
if systemctl is-active --quiet irtt.service; then
    deb-systemd-invoke try-restart irtt.service || true
fi

# Disable last login message after user SSHs in
if grep -q -E "^?PrintLastLog" /etc/ssh/sshd_config; then
    sudo sed -i "s/^#\?PrintLastLog.*/PrintLastLog no/" /etc/ssh/sshd_config
else
    echo "PrintLastLog no" >> /etc/ssh/sshd_config
fi

if ! ischroot; then
    echo "Restarting avahi-daemon ..."
    if ! deb-systemd-invoke restart avahi-daemon.service; then
        echo "avahi-daemon.service restart failed, continuing installation..." >&2
        systemctl status avahi-daemon.service >&2 || true
    fi
fi

# Drop IPv6 multicast (e.g. UniFi discovery to ff02::1) without logging it,
# the IPv6 counterpart of ufw's IPv4 broadcast rule in after.rules.
UFW_AFTER6=/etc/ufw/after6.rules
UFW_MCAST_RULE='-A ufw6-after-input -m addrtype --dst-type MULTICAST -j ufw6-skip-to-policy-input'
if [ -f "$UFW_AFTER6" ] && ! grep -qxF -- "$UFW_MCAST_RULE" "$UFW_AFTER6"; then
    sed -i "/^COMMIT\$/i $UFW_MCAST_RULE" "$UFW_AFTER6"
    if ! ischroot && command -v ufw >/dev/null; then
        ufw reload >/dev/null || true
    fi
fi

# Fails during apt install wlanpi-common due to apt lock conflict
#echo "Running apt update"
#apt update 1> /dev/null 2>& 1
