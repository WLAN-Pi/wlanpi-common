#!/usr/bin/make -f
# You must remove unused comment lines for the released package.
#export DH_VERBOSE = 1
#export DEB_BUILD_MAINT_OPTIONS = hardening=+all
#export DEB_CFLAGS_MAINT_APPEND  = -Wall -pedantic
#export DEB_LDFLAGS_MAINT_APPEND = -Wl,--as-needed

%:
	dh $@

override_dh_auto_install:
	dh_auto_install -- prefix=/usr

override_dh_installsystemd:
	dh_installsystemd --name=wlanpi-networkinfo
	dh_installsystemd --name=wlanpi-check-for-updates
	# Boot-time oneshots: enabled, but not started on install or upgrade.
	dh_installsystemd --no-start --name=wlanpi-rename-at-startup
	dh_installsystemd --no-start --name=wlanpi-config-at-startup
